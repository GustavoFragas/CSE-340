<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <h2><%= project.title %></h2>
    <p><%= project.description %></p>
    <p>Date: <%= new Date(project.date).toLocaleDateString('en-US', { timeZone: 'UTC' }) %></p>
    <p>Location: <%= project.location %></p>
    <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %>
</a>
</main>

<%- include('partials/footer') %>
